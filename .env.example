# Copiar a `.env` (NO se versiona). En Dokploy van en la pestaña Environment: este valor
# es el nombre del servicio en la red docker de Dokploy (`dokploy-network`). En local, se
# usa el valor por omisión de application.properties (http://localhost:8080): para
# desarrollar localmente no copiar este archivo, o sobrescribir esta variable.

# URL interna del servicio core.
CORE_URL=http://mejor-vejez-api:8080
# Clave compartida entre los microservicios: la MISMA en core, alertas y reportes.
# Generar una larga y aleatoria (p. ej. `openssl rand -hex 32`). Nunca versionarla.
CLAVE_SERVICIO=
# Apaga los procesos programados (detección de atrasos y alertas preventivas) sin detener el servicio.
PROCESOS_HABILITADOS=true

# Detección de atrasos y alertas preventivas: ventanas y disparo (America/Santiago).
ALERTAS_HORAS_RETROSPECTIVA=48
ALERTAS_HORAS_CITA=24
ALERTAS_DIAS_REPOSICION=3
ALERTAS_CRON_DETECCION=0 */5 * * * *
ALERTAS_CRON_PREVENTIVAS=0 10 * * * *

# Correo (SMTP). En local: Mailpit (MAIL_HOST=localhost MAIL_PORT=1025 MAIL_SMTP_AUTH=false MAIL_STARTTLS=false).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_REMITENTE=
# Timeout SMTP de conexión, lectura y escritura (ms); un SMTP colgado termina en intento FALLIDO.
MAIL_TIMEOUT_MS=10000
APP_URL=http://localhost:4200
