# Copiar a `.env` (NO se versiona). En Dokploy van en la pestaña Environment.

# URL interna del servicio core.
CORE_URL=http://localhost:8080
# Clave compartida entre los microservicios: la MISMA en core, alertas y reportes.
# Generar una larga y aleatoria (p. ej. `openssl rand -hex 32`). Nunca versionarla.
CLAVE_SERVICIO=

# Correo (SMTP). En local: Mailpit (MAIL_HOST=localhost MAIL_PORT=1025 MAIL_SMTP_AUTH=false MAIL_STARTTLS=false).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_REMITENTE=
APP_URL=http://localhost:4200
